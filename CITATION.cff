# The CFF `license` field describes the software.
license: AGPL-3.0-only
keywords:
  - public libraries
  - India
  - RRRLF
  - National Mission on Libraries
  - fiscal opacity
  - budget data extraction
  - PDF OCR
  - Right to Read
version: "0.1.0-pre"
date-released: "2026-05-12"
