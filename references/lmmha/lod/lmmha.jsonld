      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://data.commonerllp.org/ontology/lmmha/scheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Contributions to Pensions and Gratuities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Contributions payable by one Government to another on account of pensions and gratuities of officers who are either borne on the joint cadre of the two Governments, or lent to the former by the latter Government, are debited to this head. When payments are made at combined rates for both pensions and leave salaries, such contributions are also debited to this head. Leave salary contributions, when paid separately, are, however, debited to the functional major heads concerned. Allocation of Pensions and Gratuities between Central Government and State Governments has been dispensed with from 1.4.1987. This minor head has been retained to accommodate old cases."
      }
    ]
  },
