      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Interest which is in the nature of penalties for delayed payments like interest on arrears of revenue etc. will be adjusted as revenue receipts under the concerned receipt major heads and not here."
      },
      {
        "@language": "en",
        "@value": "Separate sub heads may be opened under the minor head below this sub-major head corresponding to minor heads under the various major heads in the sector \"F-Loans and Advances\"."
      }
    ]
  },
  {
    "@id": "https://data.commonerllp.org/ontology/lmmha/2059-01-104",
    "@type": [
