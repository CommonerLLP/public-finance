      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "This minor head shall be operated to classify temporarily the advances received by the State Government as recommended by the 7th Finance commission pending issue of presidential order within the close of the Financial year and such advances shall be free of interest. The advances so classified shall be withdrawn within the account of the same financial year by minus credit and shall be brought to account under the major head \"1601-Grants-in-aid from central Government\","
      }
