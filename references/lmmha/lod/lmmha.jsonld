    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Sale of Gold by Public auction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The minor head shall record the gross sale proceeds of gold sold by public auction by the Reserve Bank of India. The conversion charges payable to Bombay Mint and the expenditure to be reimbursed to R.B.I. and other incidental expenses on the sale of gold by auction would be accounted for under the new sub head \"Deduct - other charges\" to be opened under this minor head."
      }
    ]
  },
