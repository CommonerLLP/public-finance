    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "This minor head will have the following detailed heads. At the time of issue of bills, revenue will be directly booked to the relevant revenue head under ‘1225 Telecommunication Receipts’ viz., current year's revenue. Advance revenue and previous year's revenue (if the accounts of the previous year are open, otherwise it will be treated as current year's revenue) by per contra debit (minus credit) to the head '1225 Telecommunications Receipts-Telephones or Telegraphs Accounts Receivable’. Subsequent recoveries of the bills will be credited to the detailed head 'Accounts receivable'."
      }
    ]
  },
