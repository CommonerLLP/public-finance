  {
    "@id": "https://data.commonerllp.org/ontology/lmmha/8673-00-101",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "8673-00-101"
