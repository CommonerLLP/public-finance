  {
    "@id": "https://data.commonerllp.org/ontology/lmmha/2020-00-103",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "2020-00-103"
      }
