    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Reserve Bank Suspense-Headquarters"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "This head will be operated by Accountants General in their State Section of accounts and by Accountants General of U.T. Governments / Administrations in their Central Section of account in connection with debits and credits appearing in bank scrolls on account of cash settlement of inward accounts received by him on account of inter- Government transactions from a separated Pay and Accounts Office or Accounts Officers of Defence, Railways, Post and Telecommunication pending adjusting of the accounts received from the other party. Separate sub-heads \"Transactions adjustable by ...............(Name of the Central PAO/Defence/Railways/Posts/ Telecommunication Accounts Officer) \"shall be opened under this major head for each Accounts Officer with whom the transactions are to be settled. The amounts so adjusted will be cleared by minus debit or minus credit, as the case may be."
      }
    ]
  },
