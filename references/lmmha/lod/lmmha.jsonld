    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The unclaimed balances of these bonds are usually retained in Government Accounts for 20 years from the date of their maturity after which the balances are transferred to Revenue by credit to the head '0075 Miscellaneous General Services - Other Receipts'. Repayments of these amounts subsequently claimed likewise will be debited to the head '2075-Miscellaneous General Services - Other Expenditure’."
      }
