    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Deposits for purchases etc, abroad"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Amounts deposited in respect of purchase and procurements under foreign Credit/Loan agreements are adjusted under a sub-head \"Purchases under Credit/Loan agreements\", while those relating to other purchase and procurements, viz. through the I.S.M. etc. are taken to a sub-head \"Other purchases.\" Suitable detailed heads may be opened for each Credit/Loan agreements wherever necessary. Another sub-head \"Miscellaneous\" is intended to account for the rupee deposits made by the State Electricity Boards on account of inspection charges."
      }
    ]
  },
