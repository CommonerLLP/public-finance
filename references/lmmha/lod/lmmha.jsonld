      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Remittances into Banks/ Treasuries"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The Cheques/Bank Drafts received from various quarters either in settlement of outward claims or otherwise, would be initially entered in the 'Register of valuables'. The Cheques/Drafts alongwith supporting challans when sent to the branch of the accredited Bank would be classified as debit to this major head per contra credit or minus debit to the concerned minor / major heads of account. On receipt of bank scroll in which the proceeds of such cheques/drafts stand included, this major head would be cleared by minus debit per contra debit to the minor head \"Public Sector Bank Suspense\" under the concerned major head of the Department or under the concerned minor head below the major head \"8675 - Deposits with Reserve Bank\" as the case may be."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://data.commonerllp.org/ontology/lmmha/scheme"
      }
    ]
  },
