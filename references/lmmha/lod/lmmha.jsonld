    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "This head receives the sums made over by the liquidators to the Superintendent of Insurance under Section 93(5) of the Insurance Act,1938. If within a period of five years from the date on which any sums have been made over to the Superintendent of Insurance an order of a Court of competent jurisdiction has not been obtained at the instance of any claimant to such sums for their disposal, the said sums shall become the property of Government."
      }
