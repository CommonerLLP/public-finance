    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Pensionary charges in respect of High Court Judges"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "This minor head will include payments made on account of both pensions and Commuted value of pensions and gratuity or other sums payable by way of death on retirement benefits. In the books of the Central Government it will cover pensions etc. paid under Article, 112 (3) (d) (iii) of the Constitution which are recoverable from State Governments under Article 290 ibid. In the books of the State Governments, it will cover pensionary charges reimbursed to the Central Government under Article 290 of the constitution."
      }
    ]
  },
