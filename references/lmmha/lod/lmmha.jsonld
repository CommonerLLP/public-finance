      {
        "@language": "en",
        "@value": "Inspection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The expenditure on purchase, inspection and disposal wings (both in Central and State Governments) will be recorded under the respective minor heads. The pay, allowances etc. of common Director General /Director will be shown under the wing having major activity. A similar procedure may be adopted for the overseas organisation like India Store Department, London and India Supply Missions, Washington."
      }
    ]
  },
