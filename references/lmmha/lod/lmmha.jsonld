    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "See Note (1) below major head \"8116- Revenue Reserve Funds.\""
      },
      {
        "@language": "en",
        "@value": "These minor heads will include also the transactions on account of the Contingency Reserve Funds of the Nuclear Power Schemes. For this purpose a separate sub-head may be opened for the Contingency Reserve Fund of each Nuclear Power Station."
